# API keys for the Jevline command line and the local website preview (node scripts/serve_site.js).
#
#     cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. Never commit real keys. Environment variables with the
# same names take precedence over this file.

# Jev (TypeSafe), for analyze. See https://docs.typesafe.ai/introduction/quickstart
# In the local website preview this is the demo key, used only for the bundled example.
TYPESAFE_API_KEY=

# Optional: only the benchmark (engine/bench/compare.ts) reads it here. On the website,
# visitors type their own OpenRouter key into the page for narratives.
OPENROUTER_API_KEY=
