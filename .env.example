# API keys for the Jevline portal and CLI.
#
# Easiest: let the portal write .env for you (input is hidden):
#     python3 web_app.py --setup-keys
#
# Or copy this file and fill it in by hand:
#     cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. Never commit real keys. Environment variables with the
# same names take precedence over this file.

# Required for "Analyze with Jev". See https://docs.typesafe.ai/introduction/quickstart
TYPESAFE_API_KEY=

# Optional: only used by "Request narrative" (OpenRouter, deepseek/deepseek-v4.1-flash).
OPENROUTER_API_KEY=
